{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "File Backup",
  "version": "0.1.0",
  "identifier": "com.filebackup.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "File Backup", "width": 1040, "height": 660, "minWidth": 860, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0", "hardenedRuntime": true }
  }
}
