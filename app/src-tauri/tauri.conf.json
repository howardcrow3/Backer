{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backer",
  "version": "0.5.0",
  "identifier": "com.backer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Backer",
        "width": 1040,
        "height": 660,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "externalBin": [
      "binaries/backer-agent"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1M0M4Q0UwQTY5RTUwMkMKUldRc1VKNm00SXc4RlMva2RpRTllTGdkLzRkazNtQ2IrQkhyd0dQclJ0d3lMR2hHT3ljTEU5dlgK",
      "endpoints": [
        "https://updates.example.com/backer/latest.json"
      ]
    }
  }
}
